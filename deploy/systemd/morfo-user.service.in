[Unit]
Description=MORFO Perception and Scientific Analysis Platform
Documentation=file://@MORFO_ROOT@/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@MORFO_ROOT@
EnvironmentFile=-@MORFO_ROOT@/.env
ExecStart=@MORFO_EXEC_START@
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

NoNewPrivileges=true
@MORFO_SANDBOX@
UMask=0077

[Install]
WantedBy=default.target
