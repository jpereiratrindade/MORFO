# MORFO — Configuração de Ambiente de Produção e Autenticação SMTP
# Localização recomendada no servidor: /etc/morfo.env (chmod 600)
# Ou localmente no diretório do projeto: ./.env (chmod 600)

# Rede e Armazenamento
MORFO_HOST=0.0.0.0
MORFO_PORT=8091
MORFO_DATA_DIR=./var
MORFO_WEB_DIR=./web

# Segredo criptográfico fixo para persistência de sessões entre reinicializações
MORFO_AUTH_SECRET=

# Configuração SMTP (Gmail ou institucional Embrapa)
# No Gmail, gere uma "Senha de App" de 16 caracteres em: https://myaccount.google.com/apppasswords
MORFO_SMTP_HOST=smtp.gmail.com
MORFO_SMTP_PORT=587
MORFO_SMTP_USER=seu-email@gmail.com
MORFO_SMTP_PASS=sua-senha-de-app
MORFO_SMTP_FROM=seu-email@gmail.com
MORFO_SMTP_FROM_NAME="MORFO LABECO"

# Modo de desenvolvimento (0 = produção com envio real de e-mails, 1 = simulação no console)
MORFO_DEV_AUTH=0
