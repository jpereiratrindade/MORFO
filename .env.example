# MORFO — Variáveis de Ambiente para Autenticação SMTP e Execução Local / Rede LABECO

# Configuração de Rede
MORFO_HOST=0.0.0.0
MORFO_PORT=8091
MORFO_DATA_DIR=./var

# -----------------------------------------------------------------------------
# Configuração de Envio de E-mail (Gmail SMTP)
# Para o Gmail, gere uma "Senha de App" de 16 caracteres em:
# https://myaccount.google.com/apppasswords
# -----------------------------------------------------------------------------
MORFO_SMTP_HOST=smtp.gmail.com
MORFO_SMTP_PORT=587
MORFO_SMTP_USER=
MORFO_SMTP_PASS=
MORFO_SMTP_FROM=

# Segredo criptográfico fixo para HMAC das chaves (opcional, gerado aleatoriamente se ausente)
MORFO_AUTH_SECRET=

# Modo de desenvolvimento / piloto local:
# Se MORFO_DEV_AUTH=1, o código é exibido no console da interface para facilitar testes locais
MORFO_DEV_AUTH=0
