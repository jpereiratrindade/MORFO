# MORFO / LABECO-ID — Configuração de Ambiente para Piloto e Produção
# Copie este arquivo para .env e preencha com as credenciais do Google Cloud:
#   cp .env.example .env

MORFO_HOST=0.0.0.0
MORFO_PORT=8091
MORFO_DATA_DIR=./var

# -----------------------------------------------------------------------------
# Google OpenID Connect (Autenticação Institucional Workspace @embrapa.br)
# Crie o cliente OAuth na Google Auth Platform (tipo: Web Application)
# -----------------------------------------------------------------------------
MORFO_GOOGLE_CLIENT_ID=
MORFO_GOOGLE_CLIENT_SECRET=
MORFO_GOOGLE_REDIRECT_URI=http://127.0.0.1:8091/api/v1/auth/google/callback

# Endpoints oficiais do Google (padrão)
# MORFO_OIDC_ISSUER=https://accounts.google.com
# MORFO_OIDC_AUTH_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
# MORFO_OIDC_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
# MORFO_OIDC_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
# MORFO_OIDC_REQUIRED_HD=embrapa.br

# -----------------------------------------------------------------------------
# Segurança Operacional
# -----------------------------------------------------------------------------
# Desabilitar dev_code no JSON de login legado por OTP
MORFO_DISABLE_DEV_OTP=1
